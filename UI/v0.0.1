--// Window
function Library:CreateWindow(options)
	options = options or {}

	local gui = getGui()
	local theme = Themes[options.Theme or "Rebirth"] or Themes.Rebirth
	local width = options.Width or 580
	local height = options.Height or 420

	local Window = {
		Theme = theme,
		Tabs = {},
		ActiveTab = nil,
		Visible = true,
		Minimized = false,
		ToggleKey = options.ToggleKey or Enum.KeyCode.RightShift,
	}

	-- Root
	local Holder = create("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = options.Position or UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local WindowScale = create("UIScale", { Name = "WindowScale", Scale = 0.01, Parent = Holder })

	local Sunburst
	if options.Sunburst ~= false then
		local size = math.max(width, height) * 1.6
		Sunburst = create("ImageLabel", {
			Name = "Sunburst",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size, size),
			BackgroundTransparency = 1,
			Image = Assets.Sunburst,
			ImageColor3 = theme.TopHighlight,
			ImageTransparency = 0.45,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 0,
			Parent = Holder,
		})
	end

	local Main = create("Frame", {
		Name = "Main",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.Canvas,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 1,
		Parent = Holder,
	})
	addCorner(Main, 4)
	addStroke(Main, Palette.Outline, 3.5)

	-- Header
	local Header = create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, HEADER_HEIGHT),
		BackgroundColor3 = Palette.White,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = Main,
	})
	addCorner(Header, 4)
	create("UIGradient", { Color = theme.Gradient, Rotation = 90, Parent = Header })

	local headerDamier = create("ImageLabel", {
		Name = "Damier",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image = Assets.Damier,
		ImageColor3 = theme.Damier,
		ScaleType = Enum.ScaleType.Tile,
		TileSize = UDim2.fromOffset(24, 24),
		ZIndex = 3,
		Parent = Header,
	})
	create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ nkp(0, 1), nkp(0.33, 0.82), nkp(0.66, 0.35), nkp(1, 0.1) }),
		Parent = headerDamier,
	})

	create("Frame", {
		Name = "TopHighlight",
		Position = UDim2.fromOffset(4, 2),
		Size = UDim2.new(1, -8, 0, 2),
		BackgroundColor3 = theme.TopHighlight,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = Header,
	})
	create("Frame", {
		Name = "DividerAccent",
		Position = UDim2.new(0, 0, 1, -6),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = theme.DivDark,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = Header,
	})
	create("Frame", {
		Name = "DividerShadow",
		Position = UDim2.new(0, 0, 1, -3),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = Palette.Black,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = Header,
	})

	local TitleLabel, SubtitleLabel
	if options.Subtitle then
		TitleLabel = newText(Header, {
			Text = upper(options.Title or "Check-UI"),
			Size = 26,
			Stroke = 3.5,
			Position = UDim2.fromOffset(18, 6),
			Bounds = UDim2.new(1, -120, 0, 30),
			Truncate = true,
			ZIndex = 5,
		})
		SubtitleLabel = newText(Header, {
			Text = upper(options.Subtitle),
			Size = 12,
			Stroke = 2,
			Color = theme.TopHighlight,
			Position = UDim2.fromOffset(18, 34),
			Bounds = UDim2.new(1, -120, 0, 16),
			Truncate = true,
			ZIndex = 5,
		})
	else
		TitleLabel = newText(Header, {
			Text = upper(options.Title or "Check-UI"),
			Size = 30,
			Stroke = 3.5,
			Position = UDim2.fromOffset(18, 0),
			Bounds = UDim2.new(1, -120, 1, -6),
			Truncate = true,
			ZIndex = 5,
		})
	end

	local CloseButton = createBevelSquare(Header, {
		Name = "CloseButton",
		Position = UDim2.new(1, -34, 0.5, -3),
		Text = "X",
		Base = rgb(115, 0, 16),
		Face = ColorSequence.new(rgb(255, 125, 175), rgb(255, 20, 40)),
		Highlight = rgb(255, 210, 235),
		Sep = rgb(70, 0, 10),
	})

	local MinimizeButton, MinimizeLabel = createBevelSquare(Header, {
		Name = "MinimizeButton",
		Position = UDim2.new(1, -80, 0.5, -3),
		Text = "-",
		Base = rgb(153, 76, 0),
		Face = ButtonStyles.Skip,
		Highlight = rgb(255, 240, 160),
		Sep = rgb(110, 50, 0),
	})

	-- Body
	local Body = create("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(0, HEADER_HEIGHT),
		Size = UDim2.new(1, 0, 1, -HEADER_HEIGHT),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = Main,
	})

	local TabList = create("ScrollingFrame", {
		Name = "Tabs",
		Size = UDim2.new(0, SIDEBAR_WIDTH, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = Body,
	})
	addPadding(TabList, 12, 12, 10, 8)
	addList(TabList, 6)

	create("Frame", {
		Name = "SidebarDivider",
		Position = UDim2.fromOffset(SIDEBAR_WIDTH, 0),
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = Palette.Outline,
		BorderSizePixel = 0,
		Parent = Body,
	})

	local Pages = create("Frame", {
		Name = "Pages",
		Position = UDim2.fromOffset(SIDEBAR_WIDTH + 3, 0),
		Size = UDim2.new(1, -(SIDEBAR_WIDTH + 3), 1, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = Body,
	})

	-- Dragging
	do
		local dragging, dragStart, startPosition = false, nil, nil

		Header.InputBegan:Connect(function(input)
			if isPress(input) then
				dragging = true
				dragStart = input.Position
				startPosition = Holder.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)

		track(UserInputService.InputChanged:Connect(function(input)
			if dragging and isMove(input) then
				local delta = input.Position - dragStart
				Holder.Position = UDim2.new(
					startPosition.X.Scale, startPosition.X.Offset + delta.X,
					startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
				)
			end
		end))
	end

	-- Window API
	function Window:SetVisible(visible, onComplete)
		self.Visible = visible
		if visible then
			Holder.Visible = true
			tween(WindowScale, 0.35, { Scale = getDeviceScale() }, Enum.EasingStyle.Back)
			if onComplete then
				task.delay(0.35, onComplete)
			end
		else
			local t = tween(WindowScale, 0.2, { Scale = 0.01 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			t.Completed:Once(function()
				if not self.Visible then
					Holder.Visible = false
				end
				if onComplete then
					onComplete()
				end
			end)
		end
	end

	function Window:Toggle()
		self:SetVisible(not self.Visible)
	end

	function Window:SetMinimized(state)
		self.Minimized = state and true or false
		MinimizeLabel.Text = self.Minimized and "+" or "-"
		tween(Holder, 0.25, {
			Size = UDim2.fromOffset(width, self.Minimized and HEADER_HEIGHT or height),
		}, Enum.EasingStyle.Quint)
	end

	function Window:SetTitle(title, subtitle)
		TitleLabel.Text = upper(title)
		if subtitle and SubtitleLabel then
			SubtitleLabel.Text = upper(subtitle)
		end
	end

	function Window:SetToggleKey(key)
		self.ToggleKey = key
	end

	function Window:Destroy()
		self:SetVisible(false, function()
			Library:Destroy()
		end)
	end

	function Window:CreateTab(tabOptions)
		if type(tabOptions) == "string" then
			tabOptions = { Name = tabOptions }
		end
		tabOptions = tabOptions or {}

		local index = #self.Tabs + 1

		local slot = create("Frame", {
			Name = "TabSlot",
			Size = UDim2.new(1, 0, 0, 44),
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Parent = TabList,
		})

		local button = createStandardButton({
			Name = "TabButton",
			Parent = slot,
			Size = UDim2.new(1, -6, 0, 40),
			Position = UDim2.fromScale(0.5, 0.5),
			Text = upper(tabOptions.Name or "Tab"),
			TextSize = 17,
			Stroke = 2.5,
			TextColor = Palette.Muted,
			Gradient = Palette.TabIdle,
			Hover = 1.04,
			Click = 0.95,
		})

		if tabOptions.Icon then
			create("ImageLabel", {
				Name = "Icon",
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 10, 0.5, 0),
				Size = UDim2.fromOffset(22, 22),
				BackgroundTransparency = 1,
				Image = tabOptions.Icon,
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = button.ZIndex + 4,
				Parent = button,
			})
			button.Label.Size = UDim2.new(1, -38, 1, 0)
			button.Label.Position = UDim2.new(0.5, 14, 0.5, -1)
		end

		local page = create("ScrollingFrame", {
			Name = "Page",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 6,
			ScrollBarImageColor3 = theme.Accent,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Visible = false,
			Parent = Pages,
		})
		addPadding(page, 12, 14, 12, 16)
		addList(page, 10)

		local Tab = newContainer(self, page)
		Tab.Name = tabOptions.Name or "Tab"
		Tab.Button = button
		Tab.Page = page

		button.MouseButton1Click:Connect(function()
			self:SelectTab(Tab)
		end)

		table.insert(self.Tabs, Tab)
		if index == 1 then
			self:SelectTab(Tab)
		end

		return Tab
	end
	Window.AddTab = Window.CreateTab

	function Window:SelectTab(target)
		if type(target) == "string" then
			for _, tab in self.Tabs do
				if tab.Name == target then
					target = tab
					break
				end
			end
		end
		if type(target) ~= "table" then
			return
		end

		for _, tab in self.Tabs do
			local active = tab == target
			tab.Button.ButtonGradient.Color = active and theme.Gradient or Palette.TabIdle
			tab.Button.Label.TextColor3 = active and Palette.White or Palette.Muted

			if active and not tab.Page.Visible then
				tab.Page.Visible = true
				tab.Page.Position = UDim2.fromOffset(0, 12)
				tween(tab.Page, 0.25, { Position = UDim2.new() }, Enum.EasingStyle.Quint)
			elseif not active then
				tab.Page.Visible = false
			end
		end

		self.ActiveTab = target
	end

	-- Wiring
	CloseButton.MouseButton1Click:Connect(function()
		Window:Destroy()
	end)

	MinimizeButton.MouseButton1Click:Connect(function()
		Window:SetMinimized(not Window.Minimized)
	end)

	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not Window.ToggleKey then
			return
		end
		if input.KeyCode == Window.ToggleKey then
			Window:Toggle()
		end
	end))

	table.insert(Library._scaleTargets, function(scale)
		if Window.Visible then
			WindowScale.Scale = scale
		end
	end)

	if Sunburst then
		track(RunService.Heartbeat:Connect(function(dt)
			if Holder.Visible then
				Sunburst.Rotation = (Sunburst.Rotation + SUNBURST_SPEED * dt) % 360
			end
		end))
	end

	Window:SetVisible(true)

	return Window
end

--// Configs
local function encodeValue(value)
	local kind = typeof(value)
	if kind == "Color3" then
		return { __type = "Color3", value = value:ToHex() }
	elseif kind == "EnumItem" then
		return { __type = "Enum", enum = tostring(value.EnumType), value = value.Name }
	elseif kind == "table" then
		local copy = {}
		for key, item in value do
			copy[key] = encodeValue(item)
		end
		return copy
	end
	return value
end

local function decodeValue(value)
	if type(value) ~= "table" then
		return value
	end
	if value.__type == "Color3" then
		local ok, color = pcall(Color3.fromHex, value.value)
		return ok and color or nil
	elseif value.__type == "Enum" then
		local ok, item = pcall(function()
			return Enum[value.enum][value.value]
		end)
		return ok and item or nil
	end
	local copy = {}
	for key, item in value do
		copy[key] = decodeValue(item)
	end
	return copy
end

local function configPath(name)
	name = (name and name ~= "") and name or "default"
	return Library.ConfigFolder .. "/" .. name .. ".json"
end

function Library:SaveConfig(name)
	if not (writefile and makefolder and isfolder) then
		self:Notify({ Title = "Config", Content = "Your executor doesn't support saving files.", Style = "Error" })
		return false
	end

	if not isfolder(self.ConfigFolder) then
		makefolder(self.ConfigFolder)
	end

	local data = {}
	for flag, value in self.Flags do
		data[flag] = encodeValue(value)
	end

	local ok, err = pcall(function()
		writefile(configPath(name), HttpService:JSONEncode(data))
	end)

	if ok then
		self:Notify({ Title = "Config Saved", Content = "Saved as \"" .. (name ~= "" and name or "default") .. "\".", Style = "Success", Duration = 3 })
	else
		self:Notify({ Title = "Config", Content = "Failed to save: " .. tostring(err), Style = "Error" })
	end
	return ok
end

function Library:LoadConfig(name)
	if not (readfile and isfile) then
		self:Notify({ Title = "Config", Content = "Your executor doesn't support reading files.", Style = "Error" })
		return false
	end

	local path = configPath(name)
	if not isfile(path) then
		self:Notify({ Title = "Config", Content = "No config named \"" .. tostring(name) .. "\".", Style = "Warning" })
		return false
	end

	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then
		self:Notify({ Title = "Config", Content = "That config file is corrupted.", Style = "Error" })
		return false
	end

	for flag, raw in data do
		local option = self.Options[flag]
		if option and option.Set then
			pcall(option.Set, option, decodeValue(raw))
		end
	end

	self:Notify({ Title = "Config Loaded", Content = "Loaded \"" .. tostring(name) .. "\".", Style = "Success", Duration = 3 })
	return true
end

function Library:ListConfigs()
	local names = {}
	if not (listfiles and isfolder) or not isfolder(self.ConfigFolder) then
		return names
	end
	for _, path in listfiles(self.ConfigFolder) do
		local name = string.match(path, "([^/\\]+)%.json$")
		if name then
			table.insert(names, name)
		end
	end
	table.sort(names)
	return names
end

--// Lifecycle
function Library:Track(connection)
	return track(connection)
end

function Library:OnUnload(callback)
	table.insert(self._unloadCallbacks, callback)
end

function Library:Destroy()
	if self.Unloaded then
		return
	end
	self.Unloaded = true

	for _, callback in self._unloadCallbacks do
		pcall(callback)
	end

	for _, connection in self._connections do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(self._connections)
	table.clear(self._scaleTargets)

	if self.Gui then
		self.Gui:Destroy()
		self.Gui = nil
	end

	if env.__CheckUILibrary == self then
		env.__CheckUILibrary = nil
	end
end

return Library
