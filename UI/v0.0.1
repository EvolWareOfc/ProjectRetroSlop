--[[
	Check-UI Library · v0.0.1
	Cartoon / simulator-style UI library built on the Check-UI design standard.

	local Library = loadstring(game:HttpGet("<raw url>"))()

	Library:CreateWindow({ Title, Subtitle, Theme, Width, Height, ToggleKey, Sunburst, Position }) -> Window
		Themes: "Shop", "Codes", "Settings", "Rebirth", "Daily"

	Window:CreateTab({ Name, Icon }) -> Tab
	Window:SelectTab(tab | name) / :SetVisible(bool) / :Toggle() / :SetMinimized(bool)
	Window:SetTitle(text) / :SetToggleKey(KeyCode) / :Destroy()

	Tab:CreateSection(name) -> Section   (Tabs and Sections share every Add method)

	:AddToggle({ Name, Description, Default, Flag, Callback })
	:AddButton({ Name, Description, ButtonText, Style, Callback })
		Styles: "Claim", "Claimed", "Locked", "Skip", "Music", "Codes", "Rebirth"
	:AddSlider({ Name, Description, Min, Max, Default, Increment, Suffix, Format, Flag, Callback })
	:AddDropdown({ Name, Description, Options, Default, Multi, Flag, Callback })   -> :Refresh(options, keep)
	:AddInput({ Name, Description, Placeholder, Default, Numeric, ClearOnFocus, Flag, Callback })
	:AddKeybind({ Name, Description, Default, Mode, Flag, Callback, OnChanged })
		Modes: "Press" (default), "Toggle", "Hold"
	:AddColorPicker({ Name, Description, Default, Flag, Callback })
	:AddLabel(text)
	:AddParagraph({ Title, Content })
	:AddStats({ Rows = { "Status", "Target" } })   -> :Set(row, value, color)
	:AddDivider()

	Every element: :Set(value) / :Get() / :SetVisible(bool) / :Destroy()

	Library:Notify({ Title, Content, Duration, Style })   Styles: "Info", "Success", "Warning", "Error"
	Library.Flags[flag] / Library.Options[flag]
	Library:SaveConfig(name) / :LoadConfig(name) / :ListConfigs()
	Library:Track(connection) / :OnUnload(callback) / :Destroy()
]]

