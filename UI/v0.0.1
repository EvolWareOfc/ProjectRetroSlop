--// Notifications
local notifyHolder
local notifyCount = 0

local function getNotifyHolder()
	if notifyHolder and notifyHolder.Parent then
		return notifyHolder
	end

	notifyHolder = create("Frame", {
		Name = "Notifications",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 300, 1, -32),
		BackgroundTransparency = 1,
		Parent = getGui(),
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 10),
		Parent = notifyHolder,
	})

	return notifyHolder
end

function Library:Notify(options)
	if self.Unloaded then
		return
	end
	options = options or {}

	local style = NotifyStyles[options.Style or "Info"] or NotifyStyles.Info
	local duration = options.Duration or 4
	notifyCount += 1

	local slot = create("Frame", {
		Name = "Notification",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = notifyCount,
		Parent = getNotifyHolder(),
	})

	local card = create("Frame", {
		Position = UDim2.new(1, 40, 0, 0),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Palette.Canvas,
		BorderSizePixel = 0,
		Parent = slot,
	})
	addCorner(card, 4)
	addStroke(card, Palette.Outline, 3)
	addList(card)

	local header = create("Frame", {
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundColor3 = Palette.White,
		BorderSizePixel = 0,
		LayoutOrder = 1,
		Parent = card,
	})
	addCorner(header, 4)
	create("UIGradient", { Color = style, Rotation = 90, Parent = header })

	create("Frame", {
		Position = UDim2.new(0, 0, 1, -3),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = Palette.Black,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = header,
	})

	newText(header, {
		Text = upper(options.Title or "Notification"),
		Size = 18,
		Stroke = 2.5,
		Position = UDim2.fromOffset(12, 0),
		Bounds = UDim2.new(1, -24, 1, -3),
		Truncate = true,
		ZIndex = 3,
	})

	local body = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = card,
	})
	addPadding(body, 10, 12, 12, 12)
	addList(body, 10)

	newText(body, {
		Text = options.Content or "",
		Size = 14,
		Wrapped = true,
		AutoY = true,
		AlignY = Enum.TextYAlignment.Top,
		Bounds = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 1,
	})

	local timer = create("Frame", {
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = Palette.Trough,
		BorderSizePixel = 0,
		LayoutOrder = 2,
		Parent = body,
	})
	addStroke(timer, Palette.TroughStroke, 1.5)

	local fill = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.White,
		BorderSizePixel = 0,
		Parent = timer,
	})
	create("UIGradient", { Color = style, Rotation = 90, Parent = fill })

	playSound("Click")
	tween(card, 0.35, { Position = UDim2.new() }, Enum.EasingStyle.Back)
	tween(fill, duration, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Linear)

	task.delay(duration, function()
		if not slot.Parent then
			return
		end
		local t = tween(card, 0.25, { Position = UDim2.new(1, 40, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		t.Completed:Wait()
		slot:Destroy()
	end)
end

--// Containers (Tabs & Sections)
local Container = {}
Container.__index = Container

local function newContainer(window, holder)
	return setmetatable({ Window = window, Holder = holder, _order = 0 }, Container)
end

function Container:_nextOrder()
	self._order += 1
	return self._order
end

local function newCard(container, height, recessed)
	local card = create("Frame", {
		Name = "Card",
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = recessed and Palette.ReqBox or Palette.Card,
		BorderSizePixel = 0,
		LayoutOrder = container:_nextOrder(),
		Parent = container.Holder,
	})
	addCorner(card, 4)

	if recessed then
		addStroke(card, Palette.ReqBorder, 1.2)
	else
		addStroke(card, Palette.Ink, 2)
		local highlight = create("Frame", {
			Name = "InnerHighlight",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, -4, 1, -4),
			BackgroundTransparency = 1,
			Parent = card,
		})
		addCorner(highlight, 3)
		addStroke(highlight, Palette.CardHighlight, 1.2, 0.4)
	end

	return card
end

local function addTitle(card, name, description, reserve)
	reserve = reserve or 130

	if description then
		newText(card, {
			Name = "Title",
			Text = upper(name),
			Size = 18,
			Stroke = 2.5,
			Position = UDim2.fromOffset(14, 9),
			Bounds = UDim2.new(1, -(14 + reserve), 0, 22),
			Truncate = true,
		})
		newText(card, {
			Name = "Description",
			Text = upper(description),
			Size = 11,
			Color = Palette.Muted,
			Position = UDim2.fromOffset(14, 34),
			Bounds = UDim2.new(1, -(14 + reserve), 0, 16),
			Truncate = true,
		})
		return 62
	end

	newText(card, {
		Name = "Title",
		Text = upper(name),
		Size = 18,
		Stroke = 2.5,
		Position = UDim2.fromOffset(14, 0),
		Bounds = UDim2.new(1, -(14 + reserve), 0, 48),
		Truncate = true,
	})
	return 48
end

local function baseElement(instance, kind)
	local element = { Type = kind, Instance = instance }

	function element:SetVisible(visible)
		instance.Visible = visible
	end

	function element:Destroy()
		instance:Destroy()
	end

	return element
end

local function registerOption(flag, element)
	if flag then
		Library.Options[flag] = element
	end
end

local function recessedBox(parent, props)
	local box = create(props.Class or "Frame", {
		Name = props.Name or "Box",
		AnchorPoint = props.Anchor or Vector2.new(1, 0.5),
		Position = props.Position,
		Size = props.Size,
		BackgroundColor3 = Palette.ReqBox,
		BorderSizePixel = 0,
		Parent = parent,
	})
	if props.Class == "TextButton" then
		box.Text = ""
		box.AutoButtonColor = false
	end
	addCorner(box, 4)
	local stroke = addStroke(box, Palette.ReqBorder, 1.2)
	return box, stroke
end

--// Section
function Container:CreateSection(name)
	local frame = create("Frame", {
		Name = "Section",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = self:_nextOrder(),
		Parent = self.Holder,
	})
	addList(frame, 8)

	local header = create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		LayoutOrder = 0,
		Parent = frame,
	})

	local badge = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(8, 16),
		BackgroundColor3 = Palette.White,
		BorderSizePixel = 0,
		Parent = header,
	})
	addStroke(badge, Palette.Ink, 2)
	create("UIGradient", { Color = self.Window.Theme.Gradient, Rotation = 90, Parent = badge })

	newText(header, {
		Text = upper(name or "Section"),
		Size = 16,
		Stroke = 2.5,
		Position = UDim2.fromOffset(18, 0),
		Bounds = UDim2.new(1, -18, 1, 0),
		Truncate = true,
	})

	return newContainer(self.Window, frame)
end
Container.AddSection = Container.CreateSection

--// Toggle
function Container:AddToggle(options)
	options = options or {}

	local card = newCard(self, options.Description and 62 or 48)
	addTitle(card, options.Name or "Toggle", options.Description, 120)

	local button = createStandardButton({
		Name = "Toggle",
		Parent = card,
		Size = UDim2.fromOffset(92, 36),
		Position = UDim2.new(1, -60, 0.5, 0),
		Text = "OFF",
		TextSize = 22,
		Stroke = 2.5,
		Gradient = ButtonStyles.Locked,
	})

	local Toggle = baseElement(card, "Toggle")
	Toggle.Value = false

	function Toggle:Set(value, silent)
		value = value and true or false
		self.Value = value
		button.ButtonGradient.Color = value and ButtonStyles.Claim or ButtonStyles.Locked
		button.Label.Text = value and "ON" or "OFF"
		if options.Flag then
			Library.Flags[options.Flag] = value
		end
		if not silent then
			safeCallback(options.Callback, value)
		end
	end

	function Toggle:Get()
		return self.Value
	end

	button.MouseButton1Click:Connect(function()
		Toggle:Set(not Toggle.Value)
	end)

	registerOption(options.Flag, Toggle)
	Toggle:Set(options.Default == true, options.Default ~= true)

	return Toggle
end

--// Button
function Container:AddButton(options)
	options = options or {}
	local style = ButtonStyles[options.Style or "Claim"] or ButtonStyles.Claim

	local holder, button

	if options.ButtonText or options.Description then
		holder = newCard(self, options.Description and 62 or 48)
		addTitle(holder, options.Name or "Button", options.Description, 140)

		button = createStandardButton({
			Name = "Button",
			Parent = holder,
			Size = UDim2.fromOffset(110, 36),
			Position = UDim2.new(1, -69, 0.5, 0),
			Text = upper(options.ButtonText or "Run"),
			TextSize = 20,
			Stroke = 2.5,
			Gradient = style,
		})
	else
		holder = create("Frame", {
			Name = "ButtonSlot",
			Size = UDim2.new(1, 0, 0, 48),
			BackgroundTransparency = 1,
			LayoutOrder = self:_nextOrder(),
			Parent = self.Holder,
		})

		button = createStandardButton({
			Name = "Button",
			Parent = holder,
			Size = UDim2.new(1, -8, 0, 44),
			Position = UDim2.fromScale(0.5, 0.5),
			Text = upper(options.Name or "Button"),
			TextSize = 24,
			Stroke = 3,
			Gradient = style,
			Hover = 1.02,
			Click = 0.97,
		})
	end

	local Button = baseElement(holder, "Button")

	function Button:SetText(text)
		button.Label.Text = upper(text)
	end

	function Button:SetStyle(name)
		button.ButtonGradient.Color = ButtonStyles[name] or style
	end

	function Button:Fire()
		safeCallback(options.Callback)
	end

	button.MouseButton1Click:Connect(function()
		safeCallback(options.Callback)
	end)

	return Button
end

--// Slider
function Container:AddSlider(options)
	options = options or {}

	local min = options.Min or 0
	local max = options.Max or 100
	local increment = options.Increment or 1
	local fraction = string.match(tostring(increment), "%.(%d+)")
	local decimals = fraction and #fraction or 0

	local top = options.Description and 58 or 38
	local card = newCard(self, top + 42)

	newText(card, {
		Name = "Title",
		Text = upper(options.Name or "Slider"),
		Size = 18,
		Stroke = 2.5,
		Position = UDim2.fromOffset(14, 8),
		Bounds = UDim2.new(1, -28, 0, 22),
		Truncate = true,
	})

	if options.Description then
		newText(card, {
			Name = "Description",
			Text = upper(options.Description),
			Size = 11,
			Color = Palette.Muted,
			Position = UDim2.fromOffset(14, 32),
			Bounds = UDim2.new(1, -28, 0, 16),
			Truncate = true,
		})
	end

	local area = create("TextButton", {
		Name = "SliderArea",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, top),
		Size = UDim2.new(1, -32, 0, 28),
		Parent = card,
	})

	local trough = create("Frame", {
		Name = "Trough",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.Trough,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 1,
		Parent = area,
	})
	addStroke(trough, Palette.TroughStroke, 2)

	local fill = create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Palette.White,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = trough,
	})
	create("UIGradient", { Color = Palette.GoldFill, Rotation = 90, Parent = fill })
	create("Frame", {
		Name = "Bevel",
		Position = UDim2.new(0, 0, 1, -2),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = rgb(153, 60, 0),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = fill,
	})

	local valueLabel = newText(trough, {
		Name = "Value",
		Size = 16,
		Stroke = 2.6,
		AlignX = Enum.TextXAlignment.Center,
		ZIndex = 4,
	})

	local knob = create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 36),
		BackgroundColor3 = Palette.White,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = area,
	})
	addCorner(knob, 3)
	addStroke(knob, Palette.Ink, 2.5)
	create("UIGradient", {
		Color = ColorSequence.new(Palette.White, rgb(200, 208, 218)),
		Rotation = 90,
		Parent = knob,
	})
	local knobScale = create("UIScale", { Parent = knob })

	local Slider = baseElement(card, "Slider")
	Slider.Value = nil

	local function format(value)
		if options.Format then
			local ok, result = pcall(options.Format, value)
			if ok and result ~= nil then
				return upper(result)
			end
		end
		local text = string.format("%." .. decimals .. "f", value)
		if options.Suffix then
			text ..= " " .. options.Suffix
		end
		return upper(text)
	end

	function Slider:Set(value, silent)
		value = tonumber(value) or min
		value = math.floor((value - min) / increment + 0.5) * increment + min
		value = math.clamp(value, min, max)
		value = tonumber(string.format("%." .. decimals .. "f", value))

		local changed = value ~= self.Value
		self.Value = value

		local alpha = max > min and (value - min) / (max - min) or 0
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		valueLabel.Text = format(value)

		if options.Flag then
			Library.Flags[options.Flag] = value
		end
		if changed and not silent then
			safeCallback(options.Callback, value)
		end
	end

	function Slider:Get()
		return self.Value
	end

	bindDrag(area, function(position)
		local alpha = math.clamp((position.X - trough.AbsolutePosition.X) / trough.AbsoluteSize.X, 0, 1)
		Slider:Set(min + (max - min) * alpha)
	end, function()
		playSound("Click")
		tween(knobScale, 0.1, { Scale = 1.15 })
	end, function()
		tween(knobScale, 0.12, { Scale = 1 }, Enum.EasingStyle.Back)
	end)

	registerOption(options.Flag, Slider)
	Slider:Set(options.Default or min, true)

	return Slider
end

--// Dropdown
function Container:AddDropdown(options)
	options = options or {}
	local multi = options.Multi == true

	local top = options.Description and 62 or 48
	local card = newCard(self, top)
	card.ClipsDescendants = true
	addTitle(card, options.Name or "Dropdown", options.Description, 200)

	local headerButton = create("TextButton", {
		Name = "HeaderButton",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, top),
		ZIndex = 3,
		Parent = card,
	})

	local selector, selectorStroke = recessedBox(card, {
		Name = "Selector",
		Position = UDim2.new(1, -14, 0, top / 2),
		Size = UDim2.fromOffset(180, 32),
	})

	local selectedLabel = newText(selector, {
		Name = "Selected",
		Text = "NONE",
		Size = 13,
		Position = UDim2.fromOffset(10, 0),
		Bounds = UDim2.new(1, -36, 1, 0),
		Truncate = true,
	})

	local arrow = newText(selector, {
		Name = "Arrow",
		Text = ">",
		Size = 16,
		AlignX = Enum.TextXAlignment.Center,
		Anchor = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Bounds = UDim2.fromOffset(16, 16),
	})
	arrow.Rotation = 90

	local list = create("ScrollingFrame", {
		Name = "List",
		Position = UDim2.fromOffset(14, top),
		Size = UDim2.new(1, -28, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = self.Window.Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = card,
	})
	addList(list, 4)
	addPadding(list, 2, 2, 2, 8)

	local Dropdown = baseElement(card, "Dropdown")
	Dropdown.Options = options.Options or {}
	Dropdown.Value = multi and {} or nil
	Dropdown.Open = false

	local optionButtons = {}

	local function isSelected(option)
		if multi then
			return table.find(Dropdown.Value, option) ~= nil
		end
		return Dropdown.Value == option
	end

	local function updateDisplay()
		local text
		if multi then
			local names = {}
			for _, value in Dropdown.Value do
				table.insert(names, tostring(value))
			end
			text = #names > 0 and table.concat(names, ", ") or "NONE"
		else
			text = Dropdown.Value ~= nil and tostring(Dropdown.Value) or "NONE"
		end
		selectedLabel.Text = upper(text)

		for option, entry in optionButtons do
			local selected = isSelected(option)
			entry.Label.TextColor3 = selected and Palette.Lime or Palette.White
			entry.Stroke.Color = selected and Palette.Lime or Palette.ReqBorder
		end
	end

	local function listHeight()
		local visible = math.min(#Dropdown.Options, 5)
		return visible > 0 and (visible * 32 + 4) or 0
	end

	local function resize(instant)
		local height = listHeight()
		list.Size = UDim2.new(1, -28, 0, height)
		local target = Dropdown.Open and (top + height + 10) or top
		tween(card, instant and 0 or 0.22, { Size = UDim2.new(1, 0, 0, target) }, Enum.EasingStyle.Quint)
		tween(arrow, instant and 0 or 0.22, { Rotation = Dropdown.Open and -90 or 90 }, Enum.EasingStyle.Quint)
		selectorStroke.Color = Dropdown.Open and self.Window.Theme.Accent or Palette.ReqBorder
	end

	local function commit(silent)
		updateDisplay()
		local value = multi and table.clone(Dropdown.Value) or Dropdown.Value
		if options.Flag then
			Library.Flags[options.Flag] = value
		end
		if not silent then
			safeCallback(options.Callback, value)
		end
	end

	local function choose(option)
		if multi then
			local index = table.find(Dropdown.Value, option)
			if index then
				table.remove(Dropdown.Value, index)
			else
				table.insert(Dropdown.Value, option)
			end
		else
			Dropdown.Value = option
			Dropdown.Open = false
			resize()
		end
		commit()
	end

	local function build()
		for _, entry in optionButtons do
			entry.Button:Destroy()
		end
		table.clear(optionButtons)

		for index, option in Dropdown.Options do
			local button, stroke = recessedBox(list, {
				Class = "TextButton",
				Name = "Option",
				Anchor = Vector2.zero,
				Position = UDim2.new(),
				Size = UDim2.new(1, 0, 0, 28),
			})
			button.LayoutOrder = index

			local label = newText(button, {
				Name = "Label",
				Text = upper(option),
				Size = 13,
				Position = UDim2.fromOffset(10, 0),
				Bounds = UDim2.new(1, -20, 1, 0),
				Truncate = true,
			})

			button.MouseEnter:Connect(function()
				tween(button, 0.12, { BackgroundColor3 = Palette.ReqHover })
			end)
			button.MouseLeave:Connect(function()
				tween(button, 0.12, { BackgroundColor3 = Palette.ReqBox })
			end)
			button.MouseButton1Click:Connect(function()
				playSound("Click")
				choose(option)
			end)

			optionButtons[option] = { Button = button, Label = label, Stroke = stroke }
		end
	end

	function Dropdown:Set(value, silent)
		if multi then
			local selected = {}
			if type(value) == "table" then
				for _, entry in value do
					if table.find(self.Options, entry) and not table.find(selected, entry) then
						table.insert(selected, entry)
					end
				end
			elseif value ~= nil and table.find(self.Options, value) then
				selected = { value }
			end
			self.Value = selected
		else
			if value ~= nil and table.find(self.Options, value) then
				self.Value = value
			else
				self.Value = nil
			end
		end
		commit(silent)
	end

	function Dropdown:Get()
		return multi and table.clone(self.Value) or self.Value
	end

	function Dropdown:Refresh(newOptions, keepSelection)
		self.Options = newOptions or {}
		build()
		if keepSelection then
			self:Set(self.Value, true)
		else
			self:Set(multi and {} or nil, true)
		end
		resize(true)
	end

	function Dropdown:SetOpen(state)
		self.Open = state and true or false
		resize()
	end

	headerButton.MouseButton1Click:Connect(function()
		playSound("Click")
		Dropdown:SetOpen(not Dropdown.Open)
	end)

	build()
	registerOption(options.Flag, Dropdown)
	Dropdown:Set(options.Default, true)
	resize(true)

	return Dropdown
end

--// Input
function Container:AddInput(options)
	options = options or {}

	local card = newCard(self, options.Description and 62 or 48)
	addTitle(card, options.Name or "Input", options.Description, 200)

	local boxFrame, boxStroke = recessedBox(card, {
		Name = "InputBox",
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(180, 32),
	})
	boxFrame.ClipsDescendants = true

	local box = create("TextBox", {
		Name = "TextBox",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -20, 1, 0),
		Font = Enum.Font.GothamBlack,
		TextSize = 13,
		TextColor3 = Palette.White,
		PlaceholderText = upper(options.Placeholder or "Type here..."),
		PlaceholderColor3 = Palette.Placeholder,
		Text = options.Default ~= nil and tostring(options.Default) or "",
		ClearTextOnFocus = options.ClearOnFocus == true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = boxFrame,
	})
	addStroke(box, Palette.Black, 2, 0, Enum.ApplyStrokeMode.Contextual)

	local Input = baseElement(card, "Input")
	Input.Value = options.Numeric and tonumber(box.Text) or box.Text

	if options.Numeric then
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local filtered = string.gsub(box.Text, "[^%d%.%-]", "")
			if filtered ~= box.Text then
				box.Text = filtered
			end
		end)
	end

	function Input:Set(value, silent)
		if options.Numeric then
			value = tonumber(value)
			if value == nil then
				box.Text = self.Value ~= nil and tostring(self.Value) or ""
				return
			end
		else
			value = value ~= nil and tostring(value) or ""
		end
		self.Value = value
		box.Text = tostring(value)
		if options.Flag then
			Library.Flags[options.Flag] = value
		end
		if not silent then
			safeCallback(options.Callback, value)
		end
	end

	function Input:Get()
		return self.Value
	end

	box.Focused:Connect(function()
		boxStroke.Color = self.Window.Theme.Accent
	end)

	box.FocusLost:Connect(function(enterPressed)
		boxStroke.Color = Palette.ReqBorder
		Input:Set(box.Text, true)
		safeCallback(options.Callback, Input.Value, enterPressed)
	end)

	registerOption(options.Flag, Input)
	if options.Flag then
		Library.Flags[options.Flag] = Input.Value
	end

	return Input
end
Container.AddTextbox = Container.AddInput

--// Keybind
function Container:AddKeybind(options)
	options = options or {}
	local mode = options.Mode or "Press"

	local card = newCard(self, options.Description and 62 or 48)
	addTitle(card, options.Name or "Keybind", options.Description, 130)

	local bindButton, bindStroke = recessedBox(card, {
		Class = "TextButton",
		Name = "Bind",
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(104, 32),
	})

	local keyLabel = newText(bindButton, {
		Name = "Key",
		Text = "NONE",
		Size = 14,
		AlignX = Enum.TextXAlignment.Center,
		Truncate = true,
	})

	local Keybind = baseElement(card, "Keybind")
	Keybind.Value = nil
	Keybind.State = false
	Keybind.Mode = mode

	local binding = false

	local function refresh()
		if binding then
			keyLabel.Text = "..."
			bindStroke.Color = self.Window.Theme.Accent
		else
			keyLabel.Text = Keybind.Value and upper(Keybind.Value.Name) or "NONE"
			bindStroke.Color = Palette.ReqBorder
		end
	end

	function Keybind:Set(key, silent)
		if typeof(key) == "string" then
			key = Enum.KeyCode[key]
		end
		self.Value = key
		if options.Flag then
			Library.Flags[options.Flag] = key
		end
		refresh()
		if not silent then
			safeCallback(options.OnChanged, key)
		end
	end

	function Keybind:Get()
		return self.Value
	end

	bindButton.MouseButton1Click:Connect(function()
		playSound("Click")
		binding = true
		refresh()
	end)

	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if binding then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				binding = false
				if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
					Keybind:Set(nil)
				else
					Keybind:Set(input.KeyCode)
				end
			end
			return
		end

		if gameProcessed or not Keybind.Value or input.KeyCode ~= Keybind.Value then
			return
		end

		if mode == "Toggle" then
			Keybind.State = not Keybind.State
			safeCallback(options.Callback, Keybind.State)
		elseif mode == "Hold" then
			Keybind.State = true
			safeCallback(options.Callback, true)
		else
			safeCallback(options.Callback)
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		if mode == "Hold" and Keybind.State and input.KeyCode == Keybind.Value then
			Keybind.State = false
			safeCallback(options.Callback, false)
		end
	end))

	registerOption(options.Flag, Keybind)
	Keybind:Set(options.Default, true)

	return Keybind
end

