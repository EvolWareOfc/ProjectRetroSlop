	})

	local blackLayer = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.Black,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = svBox,
	})
	addCorner(blackLayer, 4)
	create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ nkp(0, 1), nkp(1, 0) }),
		Parent = blackLayer,
	})

	local svCursor = create("Frame", {
		Name = "Cursor",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = svBox,
	})
	addCorner(svCursor, 6)
	addStroke(svCursor, Palette.White, 2.5)

	local hueBar = create("TextButton", {
		Name = "Hue",
		Text = "",
		AutoButtonColor = false,
		Position = UDim2.fromOffset(0, 96),
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundColor3 = Palette.White,
		BorderSizePixel = 0,
		Parent = panel,
	})
	addCorner(hueBar, 4)
	addStroke(hueBar, Palette.Ink, 2)

	local hueKeypoints = {}
	for index = 0, 6 do
		table.insert(hueKeypoints, ColorSequenceKeypoint.new(index / 6, Color3.fromHSV(index / 6, 1, 1)))
	end
	create("UIGradient", { Color = ColorSequence.new(hueKeypoints), Parent = hueBar })

	local hueCursor = create("Frame", {
		Name = "Cursor",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(6, 20),
		BackgroundColor3 = Palette.White,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = hueBar,
	})
	addCorner(hueCursor, 2)
	addStroke(hueCursor, Palette.Ink, 2)

	local hexFrame = recessedBox(panel, {
		Name = "Hex",
		Anchor = Vector2.zero,
		Position = UDim2.fromOffset(0, 118),
		Size = UDim2.fromOffset(120, 26),
	})

	local hexBox = create("TextBox", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.new(1, -16, 1, 0),
		Font = Enum.Font.GothamBlack,
		TextSize = 13,
		TextColor3 = Palette.White,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Text = "#FFFFFF",
		Parent = hexFrame,
	})
	addStroke(hexBox, Palette.Black, 2, 0, Enum.ApplyStrokeMode.Contextual)

	local rgbLabel = newText(panel, {
		Name = "RGB",
		Text = "255, 255, 255",
		Size = 12,
		Color = Palette.Muted,
		AlignX = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(130, 118),
		Bounds = UDim2.new(1, -130, 0, 26),
	})

	local ColorPicker = baseElement(card, "ColorPicker")
	ColorPicker.Value = Palette.White
	ColorPicker.Open = false

	local hue, saturation, brightness = 0, 0, 1

	local function apply(silent)
		local color = Color3.fromHSV(hue, saturation, brightness)
		ColorPicker.Value = color

		swatch.BackgroundColor3 = color
		svBox.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
		svCursor.Position = UDim2.fromScale(saturation, 1 - brightness)
		hueCursor.Position = UDim2.new(hue, 0, 0.5, 0)
		hexBox.Text = "#" .. string.upper(color:ToHex())
		rgbLabel.Text = string.format(
			"%d, %d, %d",
			math.floor(color.R * 255 + 0.5),
			math.floor(color.G * 255 + 0.5),
			math.floor(color.B * 255 + 0.5)
		)

		if options.Flag then
			Library.Flags[options.Flag] = color
		end
		if not silent then
			safeCallback(options.Callback, color)
		end
	end

	function ColorPicker:Set(color, silent)
		if typeof(color) == "string" then
			local ok, parsed = pcall(Color3.fromHex, color)
			color = ok and parsed or nil
		end
		if typeof(color) ~= "Color3" then
			return
		end
		hue, saturation, brightness = color:ToHSV()
		apply(silent)
	end

	function ColorPicker:Get()
		return self.Value
	end

	function ColorPicker:SetOpen(state)
		self.Open = state and true or false
		tween(card, 0.22, { Size = UDim2.new(1, 0, 0, self.Open and (top + 156) or top) }, Enum.EasingStyle.Quint)
	end

	bindDrag(svBox, function(position)
		saturation = math.clamp((position.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
		brightness = 1 - math.clamp((position.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
		apply()
	end)

	bindDrag(hueBar, function(position)
		hue = math.clamp((position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
		apply()
	end)

	hexBox.FocusLost:Connect(function()
		local text = string.gsub(hexBox.Text, "#", "")
		local ok, parsed = pcall(Color3.fromHex, text)
		if ok and parsed then
			ColorPicker:Set(parsed)
		else
			apply(true)
		end
	end)

	headerButton.MouseButton1Click:Connect(function()
		playSound("Click")
		ColorPicker:SetOpen(not ColorPicker.Open)
	end)

	registerOption(options.Flag, ColorPicker)
	ColorPicker:Set(options.Default or Palette.White, true)

	return ColorPicker
end

--// Label
function Container:AddLabel(text)
	local label = newText(self.Holder, {
		Name = "Label",
		Text = text or "",
		Size = 14,
		Color = Palette.Muted,
		Wrapped = true,
		AutoY = true,
		Bounds = UDim2.new(1, 0, 0, 18),
		LayoutOrder = self:_nextOrder(),
	})

	local Label = baseElement(label, "Label")

	function Label:Set(value)
		label.Text = tostring(value)
	end

	function Label:Get()
		return label.Text
	end

	return Label
end

--// Paragraph
function Container:AddParagraph(options)
	if type(options) == "string" then
		options = { Content = options }
	end
	options = options or {}

	local card = newCard(self, 0, true)
	card.AutomaticSize = Enum.AutomaticSize.Y
	addPadding(card, 10, 12, 14, 14)
	addList(card, 4)

	local title = newText(card, {
		Name = "Title",
		Text = upper(options.Title or "Info"),
		Size = 16,
		Stroke = 2.5,
		Bounds = UDim2.new(1, 0, 0, 20),
		LayoutOrder = 1,
	})

	local content = newText(card, {
		Name = "Content",
		Text = options.Content or "",
		Size = 13,
		Color = Palette.Muted,
		Wrapped = true,
		AutoY = true,
		AlignY = Enum.TextYAlignment.Top,
		Bounds = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 2,
	})

	local Paragraph = baseElement(card, "Paragraph")

	function Paragraph:Set(newTitle, newContent)
		if newTitle then
			title.Text = upper(newTitle)
		end
		if newContent then
			content.Text = newContent
		end
	end

	return Paragraph
end

--// Stats
function Container:AddStats(options)
	options = options or {}
	local rows = options.Rows or {}

	local card = newCard(self, 0, true)
	card.AutomaticSize = Enum.AutomaticSize.Y
	addPadding(card, 4, 4, 0, 0)
	addList(card)

	local values = {}

	for index, key in rows do
		local row = create("Frame", {
			Name = "Row",
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Parent = card,
		})

		newText(row, {
			Text = upper(key),
			Size = 14,
			Color = Palette.Muted,
			Position = UDim2.fromOffset(14, 0),
			Bounds = UDim2.new(0.45, -14, 1, 0),
			Truncate = true,
		})

		values[key] = newText(row, {
			Text = "—",
			Size = 14,
			AlignX = Enum.TextXAlignment.Right,
			Anchor = Vector2.new(1, 0),
			Position = UDim2.new(1, -14, 0, 0),
			Bounds = UDim2.new(0.55, -14, 1, 0),
			Truncate = true,
		})

		if index < #rows then
			create("Frame", {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, 0),
				Size = UDim2.new(1, -24, 0, 1),
				BackgroundColor3 = Palette.ReqBorder,
				BackgroundTransparency = 0.6,
				BorderSizePixel = 0,
				Parent = row,
			})
		end
	end

	local Stats = baseElement(card, "Stats")

	function Stats:Set(key, value, color)
		local label = values[key]
		if not label then
			return
		end
		label.Text = value == nil and "—" or upper(value)
		label.TextColor3 = color or Palette.White
	end

	return Stats
end

