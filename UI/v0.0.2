	               :SetTitle(text) / :SetDescription(text) / :SetTooltip(text) / :Destroy()

	LIBRARY
	Library:Notify({ Title, Content, Duration, Style }) -> { Close }   Styles: Info, Success, Warning, Error, Theme
	Library:SetTheme(name) / :AddTheme(name, def) / :GetThemes()
