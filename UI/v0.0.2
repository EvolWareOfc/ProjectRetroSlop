function Container:AddStats(options)
	options = options or {}
	local rows = options.Rows or {}

	local card = newCard(self, 0, true)
	card.AutomaticSize = Enum.AutomaticSize.Y
	addPadding(card, 4, 4, 0, 0)
	addList(card)

	local values = {}

	for index, key in rows do
		local row = create("Frame", {
			Name = "Row",
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Parent = card,
		})

		newText(row, {
			Text = upper(key),
			Size = 14,
			Color = Palette.Muted,
			Position = UDim2.fromOffset(14, 0),
			Bounds = UDim2.new(0.45, -14, 1, 0),
			Truncate = true,
		})

		values[key] = newText(row, {
			Text = "—",
			Size = 14,
			AlignX = Enum.TextXAlignment.Right,
			Anchor = Vector2.new(1, 0),
			Position = UDim2.new(1, -14, 0, 0),
			Bounds = UDim2.new(0.55, -14, 1, 0),
			Truncate = true,
		})

		if index < #rows then
			create("Frame", {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, 0),
				Size = UDim2.new(1, -24, 0, 1),
				BackgroundColor3 = Palette.ReqBorder,
				BackgroundTransparency = 0.6,
				BorderSizePixel = 0,
				Parent = row,
			})
		end
	end

	local searchText = table.concat(rows, " ")
	local Stats = baseElement(self, card, "Stats", { Name = searchText, Tooltip = options.Tooltip })

	function Stats:Set(key, value, color)
		local label = values[key]
		if not label then
			return
		end
		label.Text = value == nil and "—" or upper(value)
		label.TextColor3 = color or Palette.White
	end

	return Stats
end

