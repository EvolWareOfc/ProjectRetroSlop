	create("Frame", {
		Position = UDim2.new(0, 0, 1, -3),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = Palette.Black,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = header,
	})

	newText(header, {
		Text = upper(options.Title or "Notification"),
		Size = 18,
		Stroke = 2.5,
		Position = UDim2.fromOffset(12, 0),
		Bounds = UDim2.new(1, -44, 1, -3),
		Truncate = true,
		ZIndex = 3,
	})

	newText(header, {
		Text = "X",
		Size = 16,
		Stroke = 2.5,
		AlignX = Enum.TextXAlignment.Center,
		Anchor = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 0),
		Bounds = UDim2.new(0, 20, 1, -3),
		ZIndex = 3,
	})

	local body = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = card,
	})
	addPadding(body, 10, 12, 12, 12)
	addList(body, 10)

	newText(body, {
		Text = options.Content or "",
		Size = 14,
		Wrapped = true,
		AutoY = true,
		AlignY = Enum.TextYAlignment.Top,
		Bounds = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 1,
	})

	local timer = create("Frame", {
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = Palette.Trough,
		BorderSizePixel = 0,
		LayoutOrder = 2,
		Parent = body,
	})
	addStroke(timer, Palette.TroughStroke, 1.5)

	local fill = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Palette.White,
		BorderSizePixel = 0,
		Parent = timer,
	})
	create("UIGradient", { Color = style, Rotation = 90, Parent = fill })

	function Notification:Close()
		if self.Closed or not slot.Parent then
			return
		end
		self.Closed = true
		local t = tween(card, 0.25, { Position = UDim2.new(1, 40, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		t.Completed:Wait()
		slot:Destroy()
