	local progress = create("NumberValue", { Value = 0 })
	progress.Changed:Connect(function(value)
		percent.Text = string.format("%d%%", math.floor(value * 100 + 0.5))
		fill.Size = UDim2.fromScale(value, 1)
	end)

	local spin = track(RunService.Heartbeat:Connect(function(dt)
		sunburst.Rotation = (sunburst.Rotation + SUNBURST_SPEED * dt) % 360
	end))

	task.spawn(function()
		tween(scale, 0.4, { Scale = getDeviceScale() }, Enum.EasingStyle.Back)
		task.wait(0.35)
		local t = tween(progress, 1.3, { Value = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		t.Completed:Wait()
		task.wait(0.25)
		local out = tween(scale, 0.25, { Scale = 0.01 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		out.Completed:Wait()
		spin:Disconnect()
		holder:Destroy()
		progress:Destroy()
		if not Library.Unloaded then
			onDone()
		end
	end)
end

--// Window
function Library:CreateWindow(options)
	options = options or {}

	if options.Theme and Themes[options.Theme] then
		self:SetTheme(options.Theme)
	end

	local gui = getGui()
	local width = options.Width or 600
	local height = options.Height or 440

	local Window = {
