		Size = UDim2.fromOffset(104, 26),
	})
	local hexBox = newTextBox(hexFrame, { Text = "#FFFFFF", Size = 13, Position = UDim2.fromOffset(8, 0), Bounds = UDim2.new(1, -16, 1, 0) })

	local function smallButton(name, text, x, width)
		local button = recessedBox(panel, {
			Class = "TextButton",
			Name = name,
			Anchor = Vector2.zero,
			Position = UDim2.fromOffset(x, 118),
			Size = UDim2.fromOffset(width, 26),
		})
		newText(button, { Text = text, Size = 11, AlignX = Enum.TextXAlignment.Center })
		button.MouseEnter:Connect(function()
			tween(button, 0.12, { BackgroundColor3 = Palette.ReqHover })
		end)
		button.MouseLeave:Connect(function()
			tween(button, 0.12, { BackgroundColor3 = Palette.ReqBox })
		end)
		return button
	end

	local copyButton = smallButton("Copy", "COPY", 110, 54)
	local pasteButton = smallButton("Paste", "PASTE", 170, 60)

	local rgbLabel = newText(panel, {
		Name = "RGB",
		Text = "255, 255, 255",
		Size = 12,
		Color = Palette.Muted,
		AlignX = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(236, 118),
		Bounds = UDim2.new(1, -236, 0, 26),
		Truncate = true,
	})

	local ColorPicker = baseElement(self, card, "ColorPicker", options)
	ColorPicker.Value = Palette.White
	ColorPicker.Open = false

	local hue, saturation, brightness = 0, 0, 1

	local function apply(silent)
		local color = Color3.fromHSV(hue, saturation, brightness)
		ColorPicker.Value = color

		swatch.BackgroundColor3 = color
		svBox.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
		svCursor.Position = UDim2.fromScale(saturation, 1 - brightness)
		hueCursor.Position = UDim2.new(hue, 0, 0.5, 0)
		hexBox.Text = "#" .. string.upper(color:ToHex())
		rgbLabel.Text = string.format(
			"%d, %d, %d",
			math.floor(color.R * 255 + 0.5),
			math.floor(color.G * 255 + 0.5),
			math.floor(color.B * 255 + 0.5)
		)

		if options.Flag then
			Library.Flags[options.Flag] = color
		end
		if not silent then
			fire(ColorPicker, options.Callback, color)
		end
	end

	function ColorPicker:Set(color, silent)
		if type(color) == "string" then
			local ok, parsed = pcall(Color3.fromHex, (string.gsub(color, "#", "")))
			color = ok and parsed or nil
		end
		if typeof(color) ~= "Color3" then
			return
		end
		hue, saturation, brightness = color:ToHSV()
		apply(silent)
	end

	function ColorPicker:Get()
		return self.Value
	end

	function ColorPicker:SetOpen(state)
		if self.Locked then
			state = false
		end
		self.Open = state and true or false
		tween(card, 0.22, { Size = UDim2.new(1, 0, 0, self.Open and (top + 156) or top) }, Enum.EasingStyle.Quint)
	end

	local function unlocked()
		return not ColorPicker.Locked
	end

	bindDrag(svBox, function(position)
		saturation = math.clamp((position.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
		brightness = 1 - math.clamp((position.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
		apply()
	end, nil, nil, unlocked)

	bindDrag(hueBar, function(position)
		hue = math.clamp((position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
		apply()
	end, nil, nil, unlocked)

	hexBox.FocusLost:Connect(function()
		local text = string.gsub(hexBox.Text, "#", "")
		local ok, parsed = pcall(Color3.fromHex, text)
		if ok and parsed then
			ColorPicker:Set(parsed)
		else
			apply(true)
		end
	end)

	copyButton.MouseButton1Click:Connect(function()
		playSound("Click")
		colorClipboard = ColorPicker.Value
		if setclipboard then
			pcall(setclipboard, "#" .. string.upper(ColorPicker.Value:ToHex()))
		end
	end)

	pasteButton.MouseButton1Click:Connect(function()
		if colorClipboard and not ColorPicker.Locked then
			playSound("Click")
			ColorPicker:Set(colorClipboard)
		end
	end)

	headerButton.MouseButton1Click:Connect(function()
		playSound("Click")
		ColorPicker:SetOpen(not ColorPicker.Open)
	end)

	registerOption(options.Flag, ColorPicker)
	ColorPicker:Set(options.Default or Palette.White, true)

	return ColorPicker
end

