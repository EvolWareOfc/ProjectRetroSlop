		ZIndex = 2,
		Parent = Main,
	})

	local searchFrame, searchStroke = recessedBox(Body, {
		Name = "Search",
		Anchor = Vector2.zero,
		Position = UDim2.fromOffset(10, 12),
		Size = UDim2.fromOffset(SIDEBAR_WIDTH - 18, 32),
	})
	local SearchBox = newTextBox(searchFrame, { Placeholder = "Search...", Size = 13 })

	local TabList = create("ScrollingFrame", {
		Name = "Tabs",
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(0, SIDEBAR_WIDTH, 1, -50),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = Body,
	})
	addPadding(TabList, 6, 12, 10, 8)
	addList(TabList, 6)

	create("Frame", {
		Name = "SidebarDivider",
		Position = UDim2.fromOffset(SIDEBAR_WIDTH, 0),
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = Palette.Outline,
		BorderSizePixel = 0,
		Parent = Body,
	})

	local Pages = create("Frame", {
		Name = "Pages",
		Position = UDim2.fromOffset(SIDEBAR_WIDTH + 3, 0),
		Size = UDim2.new(1, -(SIDEBAR_WIDTH + 3), 1, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = Body,
	})

	-- Dragging
	do
		local dragging, dragStart, startPosition = false, nil, nil

		Header.InputBegan:Connect(function(input)
			if isPress(input) then
				dragging = true
				dragStart = input.Position
				startPosition = Holder.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)

		track(UserInputService.InputChanged:Connect(function(input)
			if dragging and isMove(input) then
				local delta = input.Position - dragStart
				tween(Holder, 0.08, {
					Position = UDim2.new(
						startPosition.X.Scale, startPosition.X.Offset + delta.X,
						startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
					),
				})
			end
		end))
	end

	-- Window API
	function Window:SetVisible(visible, onComplete)
		self.Visible = visible and true or false
		if self.Visible then
			Holder.Visible = true
			tween(WindowScale, 0.35, { Scale = getDeviceScale() }, Enum.EasingStyle.Back)
			if onComplete then
				task.delay(0.35, onComplete)
			end
		else
			if tooltipFrame then
				tooltipFrame.Visible = false
			end
			local t = tween(WindowScale, 0.2, { Scale = 0.01 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			t.Completed:Once(function()
				if not self.Visible then
					Holder.Visible = false
				end
				if onComplete then
					onComplete()
				end
			end)
		end
	end

	function Window:Toggle()
		self:SetVisible(not self.Visible)
	end

	function Window:SetMinimized(state)
		self.Minimized = state and true or false
		MinimizeLabel.Text = self.Minimized and "+" or "-"
		tween(Holder, 0.25, {
			Size = UDim2.fromOffset(width, self.Minimized and HEADER_HEIGHT or height),
		}, Enum.EasingStyle.Quint)
	end

	function Window:SetTitle(title, subtitle)
		if title then
			TitleLabel.Text = upper(title)
		end
		if subtitle then
			SubtitleLabel.Text = upper(subtitle)
		end
	end

	function Window:SetToggleKey(key)
		self.ToggleKey = key
	end

	function Window:SetTheme(name)
		return Library:SetTheme(name)
	end

	function Window:Destroy()
		self:SetVisible(false, function()
			Library:Destroy()
		end)
	end

	function Window:_refreshTheme()
		self.Theme = Library.Theme
		if self.ActiveTab then
			self:SelectTab(self.ActiveTab)
		end
	end

	function Window:_applySearch(query)
		self._query = query or ""
		for _, tab in self.Tabs do
			applyFilter(tab, self._query)
		end
	end

	function Window:CreateTab(tabOptions)
		if type(tabOptions) == "string" then
			tabOptions = { Name = tabOptions }
		end
		tabOptions = tabOptions or {}

		local index = #self.Tabs + 1

		local slot = create("Frame", {
			Name = "TabSlot",
			Size = UDim2.new(1, 0, 0, 44),
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Parent = TabList,
		})

		local button = createStandardButton({
			Name = "TabButton",
			Parent = slot,
			Size = UDim2.new(1, -6, 0, 40),
			Position = UDim2.fromScale(0.5, 0.5),
			Text = upper(tabOptions.Name or "Tab"),
			TextSize = 17,
			Stroke = 2.5,
			TextColor = Palette.Muted,
			Gradient = Palette.TabIdle,
			Hover = 1.04,
			Click = 0.95,
		})

		if tabOptions.Icon then
			create("ImageLabel", {
				Name = "Icon",
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 10, 0.5, 0),
				Size = UDim2.fromOffset(22, 22),
				BackgroundTransparency = 1,
				Image = tabOptions.Icon,
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = button.ZIndex + 4,
				Parent = button,
			})
			button.Label.Size = UDim2.new(1, -38, 1, 0)
			button.Label.Position = UDim2.new(0.5, 14, 0.5, -1)
		end

		local page = create("ScrollingFrame", {
			Name = "Page",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 6,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Visible = false,
			Parent = Pages,
		})
		themed(page, "ScrollBarImageColor3", "Accent")
		addPadding(page, 12, 14, 12, 16)
		addList(page, 10)

		local Tab = newContainer(self, page, nil, nil)
		Tab.Tab = Tab
		Tab.Name = tabOptions.Name or "Tab"
		Tab.Button = button
		Tab.Page = page
		Tab._entries = {}
		Tab._sections = {}

		button.MouseButton1Click:Connect(function()
			self:SelectTab(Tab)
		end)

		table.insert(self.Tabs, Tab)
		if index == 1 then
			self:SelectTab(Tab)
		end

		return Tab
	end
	Window.AddTab = Window.CreateTab

	function Window:SelectTab(target)
		if type(target) == "string" then
			for _, tab in self.Tabs do
				if tab.Name == target then
					target = tab
					break
				end
			end
		end
		if type(target) ~= "table" then
			return
		end

		for _, tab in self.Tabs do
			local active = tab == target
			tab.Button.ButtonGradient.Color = active and Library.Theme.Gradient or Palette.TabIdle
			tab.Button.ButtonGradient.Rotation = active and Library.Theme.Rotation or 90
			tab.Button.Label.TextColor3 = active and Palette.White or Palette.Muted

			if active and not tab.Page.Visible then
				tab.Page.Visible = true
				tab.Page.Position = UDim2.fromOffset(0, 12)
				tween(tab.Page, 0.25, { Position = UDim2.new() }, Enum.EasingStyle.Quint)
			elseif not active then
				tab.Page.Visible = false
			end
		end

		self.ActiveTab = target
	end

	-- Dialogs
	function Window:Dialog(dialogOptions)
		dialogOptions = dialogOptions or {}
		local buttons = dialogOptions.Buttons or { { Text = "OK", Style = "Claim" } }

		local overlay = create("TextButton", {
			Name = "Dialog",
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Palette.Black,
			BackgroundTransparency = 1,
			ZIndex = 100,
			Parent = Main,
		})
		tween(overlay, 0.2, { BackgroundTransparency = 0.45 })

		local box = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(math.min(360, width - 40), 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Palette.Canvas,
			BorderSizePixel = 0,
			Parent = overlay,
		})
		addCorner(box, 4)
		addStroke(box, Palette.Outline, 3.5)
		addList(box)
		local boxScale = create("UIScale", { Scale = 0.8, Parent = box })
		tween(boxScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)

		local header = create("Frame", {
			Size = UDim2.new(1, 0, 0, 46),
			BackgroundColor3 = Palette.White,
			BorderSizePixel = 0,
			LayoutOrder = 1,
			Parent = box,
		})
		addCorner(header, 4)
		themeGradient(create("UIGradient", { Parent = header }))
		themed(create("Frame", {
			Position = UDim2.new(0, 0, 1, -6),
			Size = UDim2.new(1, 0, 0, 3),
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = header,
		}), "BackgroundColor3", "DivDark")
		create("Frame", {
			Position = UDim2.new(0, 0, 1, -3),
			Size = UDim2.new(1, 0, 0, 3),
			BackgroundColor3 = Palette.Black,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = header,
		})
		newText(header, {
			Text = upper(dialogOptions.Title or "Are you sure?"),
			Size = 20,
			Stroke = 3,
			Position = UDim2.fromOffset(14, 0),
			Bounds = UDim2.new(1, -28, 1, -6),
			Truncate = true,
			ZIndex = 3,
		})

		local content = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = 2,
			Parent = box,
		})
		addPadding(content, 14, 14, 16, 16)
		addList(content, 14)

		newText(content, {
			Text = dialogOptions.Content or "",
			Size = 14,
			Wrapped = true,
			AutoY = true,
			RichText = dialogOptions.RichText,
			AlignY = Enum.TextYAlignment.Top,
			Bounds = UDim2.new(1, 0, 0, 0),
			LayoutOrder = 1,
		})

		local row = create("Frame", {
			Size = UDim2.new(1, 0, 0, 44),
			BackgroundTransparency = 1,
			LayoutOrder = 2,
			Parent = content,
		})
		local rowLayout = addList(row, 10, Enum.FillDirection.Horizontal)
		rowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

		local Dialog = { Closed = false }

		function Dialog:Close()
			if self.Closed then
				return
			end
			self.Closed = true
			tween(overlay, 0.2, { BackgroundTransparency = 1 })
			local t = tween(boxScale, 0.2, { Scale = 0.01 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			t.Completed:Once(function()
				overlay:Destroy()
			end)
		end

		local count = #buttons
		for index, info in buttons do
			local slot = create("Frame", {
				Size = UDim2.new(1 / count, -(10 * (count - 1)) / count, 1, 0),
				BackgroundTransparency = 1,
				LayoutOrder = index,
				Parent = row,
			})
			local button = createStandardButton({
				Parent = slot,
				Size = UDim2.new(1, -4, 1, -4),
				Position = UDim2.fromScale(0.5, 0.5),
				Text = upper(info.Text or "OK"),
				TextSize = 20,
				Stroke = 2.5,
				Gradient = ButtonStyles[info.Style or "Claim"] or ButtonStyles.Claim,
				ZIndex = 2,
			})
			button.MouseButton1Click:Connect(function()
				if Dialog.Closed then
					return
				end
				Dialog:Close()
				safeCallback(info.Callback)
			end)
		end

		return Dialog
	end

	-- Built-in settings tab
	function Window:CreateSettingsTab(settingsOptions)
		settingsOptions = settingsOptions or {}
		local Tab = self:CreateTab({ Name = settingsOptions.Name or "Settings", Icon = settingsOptions.Icon })

		local Interface = Tab:CreateSection("Interface")

		Interface:AddDropdown({
			Name = "Theme",
			Description = "Recolors the whole UI",
			Options = Library:GetThemes(),
			Default = Library.ThemeName,
			Flag = "__Theme",
			Callback = function(name)
				if name then
					Library:SetTheme(name)
				end
			end,
		})

		Interface:AddKeybind({
			Name = "Menu Key",
			Description = "Hides and shows this window",
			Default = self.ToggleKey,
			Flag = "__MenuKey",
			ShowInList = false,
			OnChanged = function(key)
				self:SetToggleKey(key)
			end,
		})

		Interface:AddToggle({
			Name = "Watermark",
			Description = "FPS, ping and time in the corner",
			Flag = "__Watermark",
			Callback = function(state)
				Library:SetWatermark(state)
			end,
		})

		Interface:AddToggle({
			Name = "Keybind List",
			Description = "Shows your active keybinds",
			Flag = "__KeybindList",
			Callback = function(state)
				Library:SetKeybindList(state)
			end,
		})

		Interface:AddToggle({
			Name = "UI Sounds",
			Flag = "__Sounds",
			Default = Library.SoundsEnabled,
			Callback = function(state)
				Library:SetSounds(state)
			end,
		})

		local Configs = Tab:CreateSection("Configs")
		local configName = ""

		local autoloadLabel = Configs:AddLabel("AUTOLOAD: " .. upper(Library:GetAutoload() or "None"))

		Configs:AddInput({
			Name = "Config Name",
			Placeholder = "my config",
			Callback = function(text)
				configName = trim(text)
			end,
		})

		local list = Configs:AddDropdown({
			Name = "Saved Configs",
			Options = Library:ListConfigs(),
			Searchable = true,
			Callback = function(name)
				if name then
					configName = name
				end
			end,
		})

		local function refreshList()
			list:Refresh(Library:ListConfigs(), true)
			autoloadLabel:Set("AUTOLOAD: " .. upper(Library:GetAutoload() or "None"))
		end

		local function requireName()
			if configName == "" then
				Library:Notify({ Title = "Config", Content = "Type or pick a config name first.", Style = "Warning", Duration = 3 })
				return false
			end
			return true
		end

		Configs:AddButton({
			Name = "Save Config",
			ButtonText = "Save",
			Style = "Claim",
			Callback = function()
				if requireName() then
					Library:SaveConfig(configName)
					refreshList()
				end
			end,
		})

		Configs:AddButton({
			Name = "Load Config",
			ButtonText = "Load",
			Style = "Codes",
			Callback = function()
				if requireName() then
					Library:LoadConfig(configName)
				end
			end,
		})

		Configs:AddButton({
			Name = "Delete Config",
			ButtonText = "Delete",
			Style = "Locked",
			Confirm = true,
			Callback = function()
				if requireName() then
					Library:DeleteConfig(configName)
					refreshList()
				end
			end,
		})

		Configs:AddButton({
			Name = "Set Autoload",
			Description = "Loads this config every time you execute",
			ButtonText = "Autoload",
			Style = "Skip",
			Callback = function()
				if requireName() then
					Library:SetAutoload(configName)
					refreshList()
				end
			end,
		})

		Configs:AddButton({
			Name = "Clear Autoload",
			ButtonText = "Clear",
			Style = "Claimed",
			Callback = function()
				Library:SetAutoload(nil)
				refreshList()
			end,
		})

		local Danger = Tab:CreateSection("Danger Zone")

		Danger:AddButton({
			Name = "Unload",
			Description = "Removes the UI and stops everything",
			ButtonText = "Unload",
			Style = "Locked",
			Callback = function()
				self:Dialog({
					Title = "Unload?",
					Content = "This removes the UI and stops every feature. You'll need to re-execute to get it back.",
					Buttons = {
						{ Text = "Unload", Style = "Locked", Callback = function()
							self:Destroy()
						end },
						{ Text = "Cancel", Style = "Claimed" },
					},
				})
			end,
		})

		local About = Tab:CreateSection({ Name = "About", Collapsed = true })
		About:AddParagraph({
			Title = Library.Name .. " v" .. Library.Version,
			Content = "Cartoon simulator-style UI built on the Check-UI design standard.",
		})

		return Tab
	end

	-- Mobile toggle button
	local showMobileButton = options.MobileButton
	if showMobileButton == nil then
		showMobileButton = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	end

	if showMobileButton then
		local mobileButton, _, faceGradient = createBevelSquare(gui, {
			Name = "MobileToggle",
			Size = 54,
			Position = UDim2.new(0, 56, 0.5, 0),
			Text = upper(options.MobileButtonText or "RS"),
			TextSize = 22,
			Face = Library.Theme.Gradient,
			Highlight = Palette.White,
			HighlightTransparency = 0.4,
			ZIndex = 80,
		})
		themed(mobileButton, "BackgroundColor3", "DivDark")
		themeGradient(faceGradient)

		local pressing, moved, pressStart, buttonStart = false, false, nil, nil

		mobileButton.InputBegan:Connect(function(input)
			if isPress(input) then
				pressing, moved = true, false
				pressStart = input.Position
				buttonStart = mobileButton.Position
			end
		end)

		track(UserInputService.InputChanged:Connect(function(input)
			if pressing and isMove(input) then
				local delta = input.Position - pressStart
				if math.abs(delta.X) + math.abs(delta.Y) > 6 then
					moved = true
				end
				if moved then
					mobileButton.Position = UDim2.new(
						buttonStart.X.Scale, buttonStart.X.Offset + delta.X,
						buttonStart.Y.Scale, buttonStart.Y.Offset + delta.Y
					)
				end
			end
		end))

		track(UserInputService.InputEnded:Connect(function(input)
			if pressing and isPress(input) then
				pressing = false
				if not moved then
					Window:Toggle()
				end
			end
		end))

		Window.MobileButton = mobileButton
	end

	-- Wiring
	CloseButton.MouseButton1Click:Connect(function()
		Window:Dialog({
			Title = "Close " .. (options.Title or Library.Name) .. "?",
			Content = "Closing unloads everything. Use the menu key to just hide it instead.",
			Buttons = {
				{ Text = "Close", Style = "Locked", Callback = function()
					Window:Destroy()
				end },
				{ Text = "Hide", Style = "Skip", Callback = function()
					Window:SetVisible(false)
				end },
				{ Text = "Cancel", Style = "Claimed" },
			},
		})
	end)

	MinimizeButton.MouseButton1Click:Connect(function()
		Window:SetMinimized(not Window.Minimized)
	end)

	SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		Window:_applySearch(SearchBox.Text)
	end)
	SearchBox.Focused:Connect(function()
		searchStroke.Color = Library.Theme.Accent
	end)
	SearchBox.FocusLost:Connect(function()
		searchStroke.Color = Palette.ReqBorder
	end)

	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not Window.ToggleKey or Library._activeBinder or input == Library._lastBindInput then
			return
		end
		if bindMatches(input, Window.ToggleKey) then
			Window:Toggle()
		end
	end))

	table.insert(Library._scaleTargets, function(scale)
		if Window.Visible then
			WindowScale.Scale = scale
		end
	end)

	if Sunburst then
		track(RunService.Heartbeat:Connect(function(dt)
			if Holder.Visible then
				Sunburst.Rotation = (Sunburst.Rotation + SUNBURST_SPEED * dt) % 360
			end
		end))
	end

	if options.Intro ~= false then
		playIntro(options.Title or Library.Name, options.IntroText, function()
			Window:SetVisible(true)
		end)
	else
		Window:SetVisible(true)
	end

	return Window
end

--// Themes API
function Library:SetTheme(name)
	local theme = Themes[name]
	if not theme then
		return false
	end

	self.Theme = theme
	self.ThemeName = name

	for index = #self._themed, 1, -1 do
		local entry = self._themed[index]
		if entry.Instance.Parent then
			entry.Instance[entry.Property] = theme[entry.Key]
		else
			table.remove(self._themed, index)
		end
	end

	for _, window in self.Windows do
		window:_refreshTheme()
	end

	return true
end

function Library:AddTheme(name, definition)
	local gradient = definition.Gradient
	if type(gradient) == "table" then
		gradient = ColorSequence.new(gradient[1], gradient[2] or gradient[1])
	end
	Themes[name] = makeTheme(
		gradient,
		definition.Accent or Palette.White,
		definition.TopHighlight or Palette.White,
		definition.Damier or Palette.Black,
		definition.DivDark or Palette.Ink,
		definition.Rotation
	)
	if not table.find(ThemeOrder, name) then
		table.insert(ThemeOrder, name)
	end
end

function Library:GetThemes()
	return table.clone(ThemeOrder)
end

function Library:SetSounds(enabled)
	self.SoundsEnabled = enabled and true or false
end

--// Configs
local function encodeValue(value)
	local kind = typeof(value)
	if kind == "Color3" then
		return { __type = "Color3", value = value:ToHex() }
	elseif kind == "EnumItem" then
		return { __type = "Enum", enum = tostring(value.EnumType), value = value.Name }
	elseif kind == "table" then
		local copy = {}
		for key, item in value do
			copy[key] = encodeValue(item)
		end
		return copy
	end
	return value
end

local function decodeValue(value)
	if type(value) ~= "table" then
		return value
	end
	if value.__type == "Color3" then
		local ok, color = pcall(Color3.fromHex, value.value)
		return ok and color or nil
	elseif value.__type == "Enum" then
		local ok, item = pcall(function()
			return Enum[value.enum][value.value]
		end)
		return ok and item or nil
	end
	local copy = {}
	for key, item in value do
		copy[key] = decodeValue(item)
	end
	return copy
end

local function configFolder()
	return Library.Folder .. "/configs"
end

local function ensureFolders()
	if not (makefolder and isfolder) then
		return false
	end
	if not isfolder(Library.Folder) then
		makefolder(Library.Folder)
	end
	if not isfolder(configFolder()) then
		makefolder(configFolder())
	end
	return true
end

local function configPath(name)
	return configFolder() .. "/" .. name .. ".json"
end

function Library:SaveConfig(name)
	name = trim(name or "")
	if name == "" then
		return false
	end
	if not (writefile and ensureFolders()) then
		self:Notify({ Title = "Config", Content = "Your executor doesn't support saving files.", Style = "Error" })
		return false
	end

	local data = {}
	for flag, value in self.Flags do
		if not self.ConfigIgnore[flag] then
			data[flag] = encodeValue(value)
		end
	end

	local ok, err = pcall(function()
		writefile(configPath(name), HttpService:JSONEncode(data))
	end)

	if ok then
		self:Notify({ Title = "Config Saved", Content = "Saved as \"" .. name .. "\".", Style = "Success", Duration = 3 })
	else
		self:Notify({ Title = "Config", Content = "Failed to save: " .. tostring(err), Style = "Error" })
	end
	return ok
end

function Library:LoadConfig(name, silent)
	name = trim(name or "")
	if not (readfile and isfile) then
		self:Notify({ Title = "Config", Content = "Your executor doesn't support reading files.", Style = "Error" })
		return false
	end

	local path = configPath(name)
	if name == "" or not isfile(path) then
		self:Notify({ Title = "Config", Content = "No config named \"" .. name .. "\".", Style = "Warning" })
		return false
	end

	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then
		self:Notify({ Title = "Config", Content = "That config file is corrupted.", Style = "Error" })
		return false
	end

	for flag, raw in data do
		local option = self.Options[flag]
		if option and option.Set and not self.ConfigIgnore[flag] then
			pcall(option.Set, option, decodeValue(raw))
		end
	end

	if not silent then
		self:Notify({ Title = "Config Loaded", Content = "Loaded \"" .. name .. "\".", Style = "Success", Duration = 3 })
	end
	return true
end

function Library:DeleteConfig(name)
	name = trim(name or "")
	if not (delfile and isfile) then
		self:Notify({ Title = "Config", Content = "Your executor doesn't support deleting files.", Style = "Error" })
		return false
	end
	local path = configPath(name)
	if name == "" or not isfile(path) then
		self:Notify({ Title = "Config", Content = "No config named \"" .. name .. "\".", Style = "Warning" })
		return false
	end
	delfile(path)
	if self:GetAutoload() == name then
		self:SetAutoload(nil)
	end
	self:Notify({ Title = "Config Deleted", Content = "Deleted \"" .. name .. "\".", Style = "Warning", Duration = 3 })
	return true
end

function Library:ListConfigs()
	local names = {}
	if not (listfiles and isfolder) or not isfolder(configFolder()) then
		return names
	end
	for _, path in listfiles(configFolder()) do
		local name = string.match(path, "([^/\\]+)%.json$")
		if name then
			table.insert(names, name)
		end
	end
	table.sort(names)
	return names
end

function Library:SetAutoload(name)
	if not (writefile and ensureFolders()) then
		return false
	end
	local path = self.Folder .. "/autoload.txt"
	if name and name ~= "" then
		writefile(path, name)
		self:Notify({ Title = "Autoload", Content = "\"" .. name .. "\" will load on execute.", Style = "Info", Duration = 3 })
	elseif delfile and isfile and isfile(path) then
		delfile(path)
	end
	return true
end

function Library:GetAutoload()
	local path = self.Folder .. "/autoload.txt"
	if readfile and isfile and isfile(path) then
		local ok, name = pcall(readfile, path)
		if ok and name ~= "" then
			return trim(name)
		end
	end
	return nil
end

function Library:LoadAutoload()
	local name = self:GetAutoload()
	if name then
		return self:LoadConfig(name)
	end
	return false
end

--// Lifecycle
function Library:Track(connection)
	return track(connection)
end

function Library:OnUnload(callback)
	table.insert(self._unloadCallbacks, callback)
end

function Library:Destroy()
	if self.Unloaded then
		return
	end
	self.Unloaded = true

	for _, callback in self._unloadCallbacks do
		pcall(callback)
	end

	for _, connection in self._connections do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(self._connections)
	table.clear(self._scaleTargets)
	table.clear(self._themed)
	table.clear(self._binds)

	if self.Gui then
		self.Gui:Destroy()
		self.Gui = nil
	end

	if env.__RetroSlop == self then
		env.__RetroSlop = nil
	end
end

return Library
